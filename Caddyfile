# Public entry point on the server: automatic HTTPS (Let's Encrypt) in front of the app.
# HTTPS is needed because browsers only allow the microphone on https:// pages.
# DOMAIN comes from .env (see docker-compose.prod.yml).
{$DOMAIN} {
	reverse_proxy app:8000 {
		# Send streamed answers and spoken audio to the browser immediately.
		flush_interval -1
	}
}
