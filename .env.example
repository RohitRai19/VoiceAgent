GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voicedb

# --- RAG chat app ---
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=voiceagent-rag-chat
# If your LangSmith account is in the EU region, uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# true = also answer general questions from the model's own knowledge; false = files only
ALLOW_GENERAL_KNOWLEDGE=true

# --- Salesforce (this app's own MCP server: salesforce_case_server.py) ---
# Leave all four empty to keep Salesforce off.
# Option 1: a Connected App / External Client App with the Client Credentials Flow.
# When all three are set, they are used.
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Option 2: a Salesforce CLI login alias created for this app (sf org login web -a <alias>).
SF_ORG_ALIAS=

# --- Guardrails (all optional, shown with defaults) ---
# GUARDRAILS_ENABLED=true            # master switch
# GUARDRAILS_LLM_CHECK=true          # small-model safety check on each message (gpt-oss-20b)
# GUARDRAILS_CONFIRM_WRITES=true     # Salesforce create/update/comment wait for the user's "yes"
# GUARDRAILS_OUTPUT_FILTER=true      # stop API keys / system prompt from appearing in answers
# GUARDRAILS_MAX_INPUT_CHARS=4000
# GUARDRAILS_MSGS_PER_MINUTE=20      # per visitor (IP)
# GUARDRAILS_WRITES_PER_MINUTE=5     # confirmed Salesforce changes per visitor
# GUARDRAILS_UPLOADS_PER_MINUTE=5
# GUARDRAILS_VOICE_PER_MINUTE=20
# GUARDRAILS_TTS_PER_MINUTE=240

# --- Server only (docker-compose.prod.yml): public HTTPS address of the site ---
# DOMAIN=your-name.duckdns.org
