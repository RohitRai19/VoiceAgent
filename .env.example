GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voicedb

# --- RAG chat app ---
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=voiceagent-rag-chat
# If your LangSmith account is in the EU region, uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# true = also answer general questions from the model's own knowledge; false = files only
ALLOW_GENERAL_KNOWLEDGE=true
